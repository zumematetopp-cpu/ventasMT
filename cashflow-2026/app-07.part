  'Higiene':['papel higienico','papel higiénico','pañuelo','panuelo','jabon de tocador','jabón de tocador','shampoo','pasta dental','cepillo','toallita','desodorante','crema dental'],
  'Lácteos':['leche','queso','yogur','manteca','crema','dulce de leche','ricota'],
  'Carnicería':['picada','carne','pollo','milanesa','asado','bife','chorizo','jamon','jamón','matambre','costilla'],
  'Verdulería':['tomate','papa','cebolla','lechuga','zanahoria','banana','manzana','naranja','limon','limón','zapallo','morron','morrón','palta'],
  'Bebidas':['gaseosa','agua','cerveza','vino','jugo','soda','fernet','coca'],
  'Mascotas':['alimento','balanceado','baloncitos','arena','perro','gato','snack pet'],
  'Almacén':['galletitas','avena','aceite','arroz','fideo','azucar','azúcar','yerba','cafe'