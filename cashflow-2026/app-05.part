","iter":250000};
let D={items:[],ing:[],dia:[],tk:[],log:[],pres:150000,presLog:[]};
let INITIAL_ITEMS=[];

let EDIT=false;
const $=i=>document.getElementById(i);
function b64bytes(s){ const b=atob(s), a=new Uint8Array(b.length); for(let i=0;i<b.length;i++)a[i]=b.charCodeAt(i); return a; }
async function unlockData(){
  const pass=$('unlock-pass').value;
  if(!pass){ $('unlock-error').textContent='Escribí la clave'; return; }
  try{
    const mat=await crypto.subtle.importKey('raw', new TextEncoder().encode(pass), 'PBKDF2', false, ['deriveKey']);
    const key=await crypto.subtle.deriveKey({name:'PBKDF2',salt:b64bytes(ENC_DATA.salt),iterations:ENC_DATA.iter,hash:'SHA-256'},mat,{name:'AES-GCM',length:256},false,['decrypt']);
    const plain=await crypto.subtle.decrypt({name:'AES-GCM',iv:b64bytes(ENC_DATA.iv)},key,b64bytes(ENC_DATA.data));
    D=JSON.parse(new TextDecoder().decode(plain));
    D.items.forEach(i=>i.m=(i.m||[]).map(c=>typeof c==='object'?c:{v:Number(c)||0,p:false}));
    if(!D.ing)D.ing=[]; if(!D.dia)D.dia=[]; if(!D.tk)D.tk=[]; if(!D.log)D.log=[]; if(!D.presLog)D.presLog=[]; if(!D.pres)D.pres=150000;
    INITIAL_ITEMS=JSON.parse(JSON.stringify(D.items));
    localStorage.setItem('cashflow2026',JSON.stringify(D));
    $('unlock').hidden=true; if(!USER) $('quien').hidden=false; barraSync('ok'); pintar(); calc(); traerDolar();
  }catch(e){ $('unlock-error').textContent='Clave incorrecta'; }
}
function cargarLocal(){
  try{
    const raw=localStorage.getItem('cashflow2026'); if(!raw) return false;
    const o=JSON.parse(raw); if(!o||!Array.isArray(o.items)||!o.items.length) return false;
    D=o; D.items.forEach(i=>i.m=(i.m||[]).map(c=>typeof c==='object'?c:{v:Number(c)||0,p:false}));
    if(!D.ing)D.ing=[]; if(!D.dia)D.dia=[]; if(!D.tk)D.tk=[]; if(!D.log)D.log=[]; if(!D.presLog)D.presLog=[]; if(!D.pres)D.pres=150000;
    INITIAL_ITEMS=JSON.parse(JSON.stringify(D.items)); $('unlock').hidden=true; if(!USER) $('quien').hidden=false; return true;
  }catch(e){ return false; }
}
