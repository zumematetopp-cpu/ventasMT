<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow,noarchive">
<title>Cash Flow 2026</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F4F5F7; --pane:#FFF; --line:#D8DCE2; --txt:#1A1D22; --mute:#7A828E;
  --band:#E9ECF0; --gold:#E9B949; --red:#C0392B; --redbg:#FBE8E6;
  --green:#1E8E5A; --greenbg:#E4F3EB; --blue:#1D4ED8; --amber:#FFF7DB; --orange:#B45309;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;padding-top:53px;background:var(--bg);color:var(--txt);font:14px/1.35 Inter,system-ui,sans-serif}
button{font-family:inherit;border:none;border-radius:8px;cursor:pointer;font-size:13px}
button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--blue);outline-offset:1px}

.top{position:fixed;top:0;left:0;right:0;z-index:40;background:var(--pane);border-bottom:1px solid var(--line);
  padding:9px 14px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.top h1{font-size:15px;font-weight:700;margin:0 auto 0 0}
.top h1 b{background:var(--gold);padding:3px 10px;border-radius:6px}
.b{background:#EDF0F4;color:#3A424E;padding:8px 12px;border:1px solid var(--line)}
.b.on{background:var(--blue);color:#fff;border-color:var(--blue)}

.scroll{overflow:auto;max-height:calc(100vh - 53px);border-bottom:2px solid var(--line)}
table{border-collapse:separate;border-spacing:0;background:var(--pane);min-width:100%}
th,td{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:0;white-space:nowrap}
thead th{position:sticky;top:0;z-index:20;background:#EDF0F4;color:var(--blue);font-weight:700;
  font-size:12px;letter-spacing:.06em;text-align:center;padding:9px 6px}
thead th:first-child{left:0;z-index:25;text-align:left;background:var(--gold);color:#241C00;font-size:14px}
col.cnr{width:38px}
th.nrh{position:sticky;left:0;z-index:26;background:var(--gold)!important;color:#241C00;
  text-align:center!important;font-size:12px!important}
tbody td.nr{position:sticky;left:0;z-index:11;background:#F2F4F7;color:var(--mute);
  text-align:center;font:12px 'IBM Plex Mono',monospace;min-width:38px;max-width:38px;padding:0 4px}
tbody tr.act td.nr{background:var(--gold);color:#241C00;font-weight:700}
tbody tr:hover td.nr{background:#FFF6D9}
tbody td:nth-child(2){position:sticky;left:38px;z-index:10}
tbody tr:hover td:nth-child(2){background:#FFF6D9}
tbody tr.act td:nth-child(2){background:var(--gold);color:#241C00;font-weight:600;box-shadow:inset 3px 0 0 #B98900}
thead th:nth-child(2){left:38px;z-index:25}
tbody tr:hover td:first-child{background:#FFF6D9}
tbody td:nth-child(2){background:var(--pane);text-align:left;
  padding:7px 10px;min-width:300px;max-width:300px;white-space:normal}
tr.sub td:nth-child(2){background:#F7F8FA}
tr.tot td:nth-child(2){background:var(--redbg)}
tr.pend td:nth-child(2){background:#FFF3E0}
tr.ing td:nth-child(2){background:var(--greenbg)}
tr.sal td:nth-child(2){background:#E8EEFB}
tr.sec td{background:var(--band)}

.sec td{background:var(--band);font-weight:700;font-size:12.5px;letter-spacing:.04em;padding:7px 10px}
tr.sub td{background:#F7F8FA;font-weight:700}
tr.sub .pg{color:var(--green)}
tr.sub .ft{color:var(--orange);font-size:11.5px;font-weight:600}
tr.sub .leg{display:block;font-size:10px;font-weight:400;color:var(--mute);letter-spacing:.04em}
tr.tot td{background:var(--redbg);color:var(--red);font-weight:700}
tr.pend td{background:#FFF3E0;color:var(--orange);font-weight:700}
tr.ing td{background:var(--greenbg);color:var(--green);font-weight:700}
tr.sal td{background:#E8EEFB;color:var(--blue);font-weight:700}

.it a{color:var(--blue);text-decoration:none}
.it a:hover{text-decoration:underline}
.it em{font-style:normal;color:var(--blue);font-weight:600;font-family:'IBM Plex Mono',monospace;font-size:12.5px}
.it .v{color:var(--mute);font-size:11.5px;font-family:'IBM Plex Mono',monospace}
tbody tr.act td{background:#FFFBEA}
tbody tr.act td:first-child{background:var(--gold);color:#241C00;font-weight:600;
  box-shadow:inset 3px 0 0 #B98900}
tbody tr.act td:first-child a{color:#241C00}
tbody tr.act td:first-child em{color:#5C4400}
tbody tr.act td.cel.ok{background:#DFF0E6}
td.cel.foco{box-shadow:inset 0 0 0 2px var(--blue)}
.pen{width:24px;height:22px;background:none;color:#B9BFC8;font-size:12px;float:right}
.pen:hover{color:var(--blue)}
.ed{display:none;gap:6px;margin-top:6px;flex-wrap:wrap}
.ed.open{display:flex}
.ed input{border:1px solid var(--line);border-radius:6px;padding:6px;font:12px 'IBM Plex Mono',monospace}
.ed input.nm,.ed input.lk{flex:1 1 100%}
.ed input.l4{width:90px}.ed input.vc{width:64px}
.ed button{background:var(--blue);color:#fff;padding:6px 12px}

/* celda mes = monto + tilde */
td.cel{padding:0}
.box{display:flex;align-items:center;min-width:132px}
.box input{flex:1;width:100%;border:none;background:transparent;text-align:right;padding:7px 4px 7px 8px;
  font:13px 'IBM Plex Mono',monospace;font-variant-numeric:tabular-nums;color:var(--orange);font-weight:500}
.box input:focus{background:#FFF9E0}
.box input::placeholder{color:#C9CFD6;font-weight:400}
.chk{width:26px;height:26px;margin-right:5px;border:1.5px solid #CBD2DA;background:#fff;color:transparent;
  border-radius:6px;font-size:13px;line-height:1;flex:0 0 auto}
.chk.on{background:var(--green);border-color:var(--green);color:#fff}
.chk.hide{visibility:hidden}
td.cel.ok{background:var(--greenbg)}
td.cel.ok .box input{color:var(--green);font-weight:600}
td.n{text-align:right;padding:7px 9px;font:13px 'IBM Plex Mono',monospace;font-variant-numeric:tabular-nums}
td.z{color:#C2C8D0}
col.hoy{background:var(--amber)}

/* ingresos */
.ing-wrap{padding:14px;display:grid;grid-template-columns:340px 1fr;gap:14px;align-items:start}
.card{background:var(--pane);border:1px solid var(--line);border-radius:10px;padding:14px}
.card h2{font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--mute);margin:0 0 10px}
.f{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px}
label{display:block;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);margin-bottom:4px}
.f input,.f select{width:100%;border:1px solid var(--line);border-radius:8px;padding:9px;
  font:14px 'IBM Plex Mono',monospace}
.res{display:block;width:100%;background:var(--greenbg);color:var(--green);border:1.5px solid #B7DEC8;
  border-radius:8px;padding:12px;text-align:center;font:600 26px 'IBM Plex Mono',monospace;margin-bottom:4px}
.res::placeholder{color:#A9CBB8}
.conv-line{text-align:center;font:13px 'IBM Plex Mono',monospace;color:var(--mute);
  min-height:20px;margin-bottom:8px}
.conv-line b{color:var(--green);font-size:15px}
.mon{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:10px}
.mon button{background:#EDF0F4;color:#3A424E;border:1px solid var(--line);padding:9px;font-size:13px}
.mon button.on{background:var(--green);color:#fff;border-color:var(--green);font-weight:600}
.add{background:var(--green);color:#fff;padding:11px;width:100%;font-weight:600}
.mv{display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid var(--line);font-size:13px}
.mv:last-child{border:0}
.mv span{color:var(--mute);font:12px 'IBM Plex Mono',monospace}
.x{background:none;color:#B9BFC8;padding:3px 7px}
.mesbloque{margin-bottom:14px}
.mesbloque h3{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--blue);
  margin:0 0 4px;display:flex;justify-content:space-between}
.empty{color:var(--mute);font-size:13px;padding:20px 0;text-align:center}
.dia-wrap{padding:0 14px 20px;display:grid;grid-template-columns:340px 1fr 1fr;gap:14px;align-items:start}
.pres{display:flex;align-items:center;justify-content:space-between;gap:10px;