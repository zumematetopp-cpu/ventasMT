import { getStore, getDeployStore } from '@netlify/blobs';
function store(){const production=Netlify.context?.deploy?.context==='production';return production?getStore('mate-topp-expert-accounts',{consistency:'strong'}):getDeployStore('mate-topp-expert-accounts')}
function shuffle<T>(arr:T[]){for(let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]]}return arr}
export default async(req:Request)=>{if(req.method!=='GET')return Response.json({ok:false,error:'Método no permitido'},{status:405});try{const s=store();const listed:any=await s.list({prefix:'account/'});const blobs=listed?.blobs||[];const accounts:any[]=[];for(const item of blobs.slice(0,300)){const a:any=await s.get(item.key,{type:'json'});if(a?.slug&&a?.firstName)accounts.push(a)}const now=Date.now();const normalized=accounts.map(a=>({firstName:a.firstName,slug:a.slug,zone:a.zone||'Argentina',priority:Number(a.publicPriority)||0,isNew:a.createdAt?now-new Date(a.createdAt).getTime()<1000*60*60*24*45:false,createdAt:a.createdAt||''}));const groups=new Map<string,any[]>();for(const e of normalized){const key=`${e.priority}|${e.isNew?1:0}`;if(!groups.has(key))groups.set(key,[]);groups.get(key)!.push(e)}const keys=[...groups.keys()].sort((a,b)=>{const [pa,na]=a.split('|').map(Number),[pb,nb]=b.split('|').map(Number);return pb-pa||nb-na});const experts=keys.flatMap(k=>shuffle(groups.get(k)||[])).map(({createdAt,priority,...e})=>e);return Response.json({ok:true,experts},{headers:{'cache-control':'no-store'}})}catch(error){return Response.json({ok:false,error:String(error instanceof Error?error.message:error)},{status:500})}}
export const config={path:'/experts-api'};
